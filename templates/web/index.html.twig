{% extends 'web/base.html.twig' %}
{% block body %}
    <div class="container py-5 text-center">
        <h1 class="display-4">Genshin Armory</h1>
        <div class="my-3 d-flex justify-content-center">
            <form method="post" action="" class="d-flex">
                <div class="input-group input-group-lg">
                    <input
                            type="number"
                            id="index-input-uid"
                            name="index-input-uid"
                            class="form-control border-2 p-2 rounded-start-2 rounded-end-0 shadow-none fw-bolder index-input-uid"
                            placeholder="Enter UID"
                            required
                    />
                    <button type="submit" class="btn rounded-start-0 rounded-end-2 index-btn-submit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-right" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"/>
                        </svg>
                    </button>
                </div>
            </form>
        </div>
        <section class="my-4">
            <h2>What?</h2>
            <p>
                Genshin Armory is a companion service for Genshin Impact.
                Its purpose is to view all your characters and collectibles (such as achievements and namecards) in a simple way.
            </p>
        </section>
        <hr />

        <section class="my-4">
            <h2>Why?</h2>
            <p>
                Genshins' default UI & UX is poorly designed - here you can easily search anything you need.
            </p>
        </section>
        <hr />

        <section class="my-4">
            <h2>How?</h2>
            <p>
                First, make sure to enable "Show Character Details" option in your in-game profile page.
                <img class="my-3 mx-auto d-block rounded-5"
                     src="{{ asset('images/show-details.png') }}"
                     alt="Enable Show Character Details">
                Then log out of the game and enter your accounts' UID into the field above.
            </p>
        </section>
    </div>
{% endblock body %}
