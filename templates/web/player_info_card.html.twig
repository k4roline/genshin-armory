<div class="row">
    <div class="col-6">
        <div class="card border-0 rounded-0">
            <img class="card-img img-fluid" src="{{ namecard(info.playerInfo.nameCardId) }}" alt=":/">
            <div class="card-img-overlay image-shadow rounded-0">
                <h5 class="card-title">{{ info.playerInfo.nickname }}</h5>
                <h6 class="card-subtitle">{{ info.playerInfo.signature }}</h6>
                <h5 class="card-footer">{{ info.uid }}</h5>
            </div>
        </div>
    </div>
</div>
<pre>{{ playerInfo|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>